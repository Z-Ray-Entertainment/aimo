msgid "Assignment (Location-independent or bound to a specific location)"
msgstr "Assegnazione (indipendente dal luogo o vincolato a un luogo specifico)"

#: flask/templates/macros/event_manager.html:77
msgid ""
"Location Restriction:\n"
"Choose whether this character event can occur anywhere in chats with this character or is additionally bound to a specific location."
msgstr ""
"Restrizione luogo:\n"
"Scegli se questo evento del personaggio può verificarsi ovunque nelle chat con questo personaggio o è legato a un luogo specifico."

#: flask/templates/macros/event_manager.html:79
