msgid ""
"Memory Model:\n"
"Automatically creates episodic summaries (memories) every 10 messages and updates the chat title."
msgstr ""
"Modello Memoria:\n"
"Crea automaticamente riassunti episodici (ricordi) ogni 10 messaggi e aggiorna il titolo della chat."

#: flask/templates/admin/services.html:129
msgid ""
"Assistant Model:\n"
"Responsible for AI author optimization (Sparkle ✨), text translations, and scene image prompts."
msgstr ""
"Modello Assistente:\n"
"Responsabile dell'ottimizzazione autore IA (Sparkle ✨), traduzioni di testo e prompt per immagini di scena."

#: flask/templates/admin/services.html:140
msgid ""
"Vision Model:\n"
"Multimodal model for visual analysis of persona portraits, 16:9 location images, and image uploads in chat."
msgstr ""
"Modello Vision:\n"
"Modello multimodale per l'analisi visiva di ritratti persona, immagini di luogo 16:9 e immagini caricate in chat."

