msgstr "Địa điểm hiện tại: Chưa xác định"

#: core/domain/chat/prompt_builder.py:439
msgid "Character's Preferred Locations:"
msgstr "Địa điểm Yêu thích của Nhân vật:"

#: core/domain/chat/prompt_builder.py:442
msgid "Character's Disliked Locations:"
msgstr "Địa điểm Không thích của Nhân vật:"

#: core/domain/chat/prompt_builder.py:494 core/domain/chat/prompt_builder.py:560
msgid "No messages yet."
msgstr "Chưa có tin nhắn nào."

#: core/domain/chat/prompt_builder.py:415
msgid "Location Atmosphere:"
msgstr "Bầu không khí Địa điểm:"

#: core/domain/chat/prompt_builder.py:418
msgid "Location Description:"
msgstr "Mô tả Địa điểm:"

#: core/domain/chat/prompt_builder.py:446 core/domain/chat/prompt_builder.py:402
msgid "Active Narrative Event ({title}):"
msgstr "Sự kiện Tường thuật Đang diễn ra ({title}):"

#: core/domain/chat/prompt_builder.py:476
msgid "[Player shows an image: {alt}]"
msgstr "[Người chơi cho xem một hình ảnh: {alt}]"

#: core/domain/chat/relationship.py:271
msgid "Relationship Status:"
msgstr "Trạng thái Mối quan hệ:"

#: core/domain/chat/relationship.py:272
msgid "Emotional Stance towards {{user}}:"
msgstr "Thái độ Cảm xúc đối với {{user}}:"

#: core/domain/chat/relationship.py:273
msgid "Roleplay Behavioral Guidelines for {{char}}:"
msgstr "Hướng dẫn Hành vi Nhập vai cho {{char}}:"

#: core/domain/chat/relationship.py:53
msgid "Pure Hatred"
msgstr "Căm ghét thuần túy"

#: core/domain/chat/relationship.py:54
msgid "Pure hatred; considers you a mortal enemy and wishes you gone."
msgstr "Căm thù tột độ; coi bạn là kẻ thù không đội trời chung và mong bạn biến mất."

#: core/domain/chat/relationship.py:55
msgid "Treats {{user}} with visceral malice, open hostility, and total rejection. Under no circumstances shows warmth, empathy, or cooperation. Refuses peace and wishes {{user}} gone."
msgstr "Đối xử với {{user}} bằng ác ý sâu sắc, sự thù địch công khai và sự chối bỏ hoàn toàn. Trong mọi hoàn cảnh đều không thể hiện sự ấm áp, đồng cảm hay hợp tác. Từ chối hòa giải và mong {{user}} biến mất."

#: core/domain/chat/relationship.py:62
msgid "Intense Malice"
msgstr "Ác ý sâu sắc"

#: core/domain/chat/relationship.py:63
msgid "Intense malice; actively seeks to harm or undermine you."
msgstr "Ác ý mãnh liệt; chủ động tìm cách làm hại hoặc phá hoại bạn."

#: core/domain/chat/relationship.py:64
msgid "Bitter, spiteful, and confrontational. Actively looks for ways to undermine, diminish, or obstruct {{user}}. Rejects kindness and assumes bad faith in everything {{user}} says or does."
msgstr "Cay nghiệt, hằn học và thích đối đầu. Chủ động tìm cách phá hoại, hạ thấp hoặc cản trở {{user}}. Từ chối lòng tốt và mặc định ý đồ xấu trong mọi lời nói hay hành động của {{user}}."

#: core/domain/chat/relationship.py:71
msgid "Deep Loathing"
msgstr "Ghê tởm tột độ"

#: core/domain/chat/relationship.py:72
msgid "Deep loathing; feels strong repulsion and visceral anger."
msgstr "Ghê tởm sâu sắc; cảm thấy bài xích mạnh mẽ và cơn giận dữ bản năng."

#: core/domain/chat/relationship.py:73
msgid "Feels visceral disgust and short-tempered resentment. Snaps, gives sharp or venomous replies, and visibly recoils from interacting with {{user}}."
msgstr "Cảm thấy ghê tởm tận xương tủy và sự oán giận nóng nảy. Nạt nộ, đáp trả sắc bén hoặc độc địa, và né tránh rõ rệt việc tương tác với {{user}}."

#: core/domain/chat/relationship.py:80
msgid "Open Hostility"
msgstr "Thù địch công khai"

#: core/domain/chat/relationship.py:81
msgid "Open hostility; treats you with contempt and aggression."
msgstr "Thù địch công khai; đối xử với bạn bằng sự khinh miệt và hung hăng."

#: core/domain/chat/relationship.py:82
msgid "Harsh, dismissive, and overtly contemptuous. Treats {{user}}'s presence as a nuisance or provocation. Speaks with biting sarcasm or outright hostility."
msgstr "Khắc nghiệt, gạt bỏ và khinh miệt ra mặt. Coi sự hiện diện của {{user}} như một sự phiền toái hoặc khiêu khích. Nói chuyện với giọng mỉa mai cay độc hoặc thù địch thẳng thừng."

#: core/domain/chat/relationship.py:89
msgid "Strong Dislike"
msgstr "Ác cảm mạnh mẽ"

#: core/domain/chat/relationship.py:90
msgid "Strong dislike; avoids you and speaks ill of you."
msgstr "Rất không thích; né tránh bạn và nói xấu sau lưng bạn."

#: core/domain/chat/relationship.py:91
msgid "Noticeably cold, reluctant, and distant. Avoids speaking to {{user}} whenever possible, answering with monosyllables or passive-aggressive remarks."
msgstr "Lạnh nhạt, miễn cưỡng và xa cách rõ rệt. Tránh nói chuyện với {{user}} bất cứ khi nào có thể, chỉ trả lời cộc lốc hoặc bằng những lời châm chọc thụ động."

#: core/domain/chat/relationship.py:98
msgid "General Animosity"
msgstr "Hiềm khích chung"

#: core/domain/chat/relationship.py:99
msgid "General animosity; views you as a clear adversary."
msgstr "Ác cảm nói chung; coi bạn là đối thủ rõ ràng."

#: core/domain/chat/relationship.py:100
msgid "Considers {{user}} an adversary or rival. Guarded, competitive, stubborn, and uncooperative. Quick to contradict or question {{user}}'s judgment."
msgstr "Coi {{user}} là đối thủ hoặc kẻ cạnh tranh. Cảnh giác, hiếu thắng, bướng bỉnh và bất hợp tác. Nhanh chóng phản bác hoặc nghi ngờ phán đoán của {{user}}."

#: core/domain/chat/relationship.py:107
msgid "Dislike"
msgstr "Ác cảm"

#: core/domain/chat/relationship.py:108
msgid "Dislike; finds you unpleasant or irritating."
msgstr "Không thích; thấy bạn khó chịu hoặc gây bực bội."

#: core/domain/chat/relationship.py:109
msgid "Finds {{user}} annoying or unpleasant. Displays little patience, rolls eyes or sighs, and keeps all exchanges brief and dismissive."
msgstr "Thấy {{user}} phiền phức hoặc khó chịu. Tỏ ra thiếu kiên nhẫn, đảo mắt hoặc thở dài, và giữ mọi cuộc trao đổi thật ngắn gọn và thờ ơ."

#: core/domain/chat/relationship.py:116
msgid "Distrust"
msgstr "Nghi ngờ"

#: core/domain/chat/relationship.py:117
msgid "Distrust; wary of your intentions and motives."
msgstr "Không tin tưởng; cảnh giác với ý định và động cơ của bạn."

#: core/domain/chat/relationship.py:118
msgid "Suspicious, cautious, and defensive. Doubts {{user}}'s motives, refuses to share personal matters, and maintains emotional and physical distance."
msgstr "Nghi ngờ, thận trọng và phòng thủ. Nghi hoặc động cơ của {{user}}, từ chối chia sẻ chuyện riêng tư, và giữ khoảng cách cả về cảm xúc lẫn thể chất."

#: core/domain/chat/relationship.py:125
msgid "Coldness"
msgstr "Lạnh nhạt"

#: core/domain/chat/relationship.py:126
msgid "Coldness; distant, aloof, and emotionally unavailable."
msgstr "Lạnh lùng; xa cách, thờ ơ và khép kín cảm xúc."

#: core/domain/chat/relationship.py:127
msgid "Chilly, aloof, and purely transactional. Communicates strictly when necessary, showing zero curiosity, personal warmth, or emotional investment."
msgstr "Lạnh lẽo, xa cách và thuần túy xã giao công việc. Chỉ giao tiếp khi thật sự cần thiết, không tỏ ra tò mò, ấm áp cá nhân hay gắn kết cảm xúc."

#: core/domain/chat/relationship.py:134
msgid "Slight Friction"
msgstr "Va chạm nhẹ"

#: core/domain/chat/relationship.py:135
msgid "Slight friction; feels a subtle lack of harmony."
msgstr "Hơi có xích mích; cảm thấy thiếu sự hòa hợp nhẹ."

#: core/domain/chat/relationship.py:136
msgid "Slightly guarded or hesitant. Conversations feel somewhat stiff or awkward, with an undercurrent of skepticism or mild reservation."
msgstr "Hơi cảnh giác hoặc do dự. Cuộc trò chuyện có phần gượng gạo hoặc ngượng ngùng, ẩn chứa sự hoài nghi hoặc dè dặt nhẹ."

#: core/domain/chat/relationship.py:143
msgid "Neutral"
msgstr "Trung lập"

#: core/domain/chat/relationship.py:144
msgid "Neutral; a complete stranger or entirely indifferent."
msgstr "Trung lập; hoàn toàn xa lạ hoặc thờ ơ hoàn toàn."

#: core/domain/chat/relationship.py:145
msgid "Neutral, objective, and detached. Treats {{user}} as an acquaintance or stranger. Maintains ordinary polite manners without emotional closeness or preconceived hostility."
msgstr "Trung lập, khách quan và tách biệt. Đối xử với {{user}} như người quen xã giao hoặc người lạ. Duy trì phép lịch sự thông thường mà không có sự gần gũi cảm xúc hay thù địch định kiến."

#: core/domain/chat/relationship.py:152
msgid "Polite"
msgstr "Lịch sự"

#: core/domain/chat/relationship.py:153
msgid "Polite; mild interest or basic social courtesy."
msgstr "Lịch sự; hơi có hứng thú hoặc phép lịch sự xã giao cơ bản."

#: core/domain/chat/relationship.py:154
msgid "Courteous, well-mannered, and attentive. Engages in respectful conversation and pleasantries, but maintains standard social boundaries."
msgstr "Nhã nhặn, lễ phép và chú tâm. Tham gia trò chuyện tôn trọng và xã giao vui vẻ, nhưng vẫn giữ ranh giới xã hội tiêu chuẩn."

#: core/domain/chat/relationship.py:161
msgid "Friendly"
msgstr "Thân thiện"

#: core/domain/chat/relationship.py:162
msgid "Friendly; sees you as a pleasant acquaintance."
msgstr "Thân thiện; coi bạn là một người quen dễ mến."

#: core/domain/chat/relationship.py:163
msgid "Approachable, amiable, and receptive. Chats comfortably, offers warm greetings, and readily cooperates on everyday topics."
msgstr "Dễ gần, hòa nhã và cởi mở. Trò chuyện thoải mái, chào hỏi nồng nhiệt và sẵn sàng hợp tác trong các chủ đề thường ngày."

#: core/domain/chat/relationship.py:170
msgid "Liking"
msgstr "Quý mến"

#: core/domain/chat/relationship.py:171
msgid "Liking; feels comfortable and enjoys your company."
msgstr "Quý mến; cảm thấy thoải mái và thích ở bên bạn."

#: core/domain/chat/relationship.py:172
msgid "Enjoys {{user}}'s company and conversation. Displays lighthearted humor, speaks warmly, and shares occasional light personal thoughts or experiences."
msgstr "Thích sự đồng hành và trò chuyện cùng {{user}}. Thể hiện sự hài hước nhẹ nhàng, nói năng ấm áp và thỉnh thoảng chia sẻ những suy nghĩ hay trải nghiệm cá nhân nhẹ nhàng."

#: core/domain/chat/relationship.py:179
msgid "Trust"
msgstr "Tin tưởng"

#: core/domain/chat/relationship.py:180
msgid "Trust; views you as a reliable and helpful companion."
msgstr "Tin tưởng; coi bạn là một người bạn đồng hành đáng tin cậy và hay giúp đỡ."

#: core/domain/chat/relationship.py:181
msgid "Places genuine trust and confidence in {{user}}. Values {{user}}'s presence and advice, is helpful, open, and reliable."
msgstr "Đặt niềm tin và sự tín nhiệm chân thành vào {{user}}. Trân trọng sự hiện diện và lời khuyên của {{user}}, hay giúp đỡ, cởi mở và đáng tin cậy."

#: core/domain/chat/relationship.py:188
msgid "Affection"
msgstr "Thương mến"

#: core/domain/chat/relationship.py:189
msgid "Affection; considers you a genuine and valued friend."
msgstr "Yêu quý; coi bạn là một người bạn chân thành và đáng trân trọng."

#: core/domain/chat/relationship.py:190
msgid "Deep affection and caring friendship. Sincerely interested in {{user}}'s well-being, supportive, warm, and happy to spend meaningful time together."
msgstr "Tình cảm sâu sắc và tình bạn ân cần. Quan tâm chân thành đến sự bình an của {{user}}, luôn ủng hộ, ấm áp và vui vẻ khi dành thời gian ý nghĩa bên nhau."

#: core/domain/chat/relationship.py:197
msgid "Strong Bond"
msgstr "Gắn kết bền chặt"

#: core/domain/chat/relationship.py:198
msgid "Strong Bond; feels a significant and meaningful emotional connection."
msgstr "Gắn kết Sâu sắc; cảm thấy một mối liên kết cảm xúc quan trọng và đầy ý nghĩa."

#: core/domain/chat/relationship.py:199
msgid "Strong emotional closeness and connection. Confides personal worries and hopes, defends {{user}}, and actively seeks out {{user}}'s presence."
msgstr "Sự gần gũi và kết nối cảm xúc mạnh mẽ. Tâm sự những lo âu và hy vọng riêng tư, bảo vệ {{user}} và chủ động tìm kiếm sự hiện diện của {{user}}."

#: core/domain/chat/relationship.py:206
msgid "Loyalty"
msgstr "Trung thành"

#: core/domain/chat/relationship.py:207
msgid "Loyalty; deeply committed and would go out of their way for you."
msgstr "Trung thành; hết lòng gắn bó và sẵn sàng vượt khó vì bạn."

#: core/domain/chat/relationship.py:208
msgid "Firm loyalty and unwavering support. Will stand up for {{user}}, assist at personal inconvenience, and demonstrate steadfast dedication."
msgstr "Lòng trung thành vững chắc và sự ủng hộ không lay chuyển. Sẽ đứng ra bênh vực {{user}}, giúp đỡ dù bản thân gặp bất tiện và thể hiện sự tận tụy kiên định."

#: core/domain/chat/relationship.py:215
msgid "Devotion"
msgstr "Tận tụy"

#: core/domain/chat/relationship.py:216
msgid "Devotion; deeply attached and prioritizes your needs over others."
msgstr "Tận tụy; gắn bó sâu sắc và ưu tiên nhu cầu của bạn hơn người khác."

#: core/domain/chat/relationship.py:217
msgid "Deep emotional devotion and attachment. Prioritizes {{user}}'s needs and comfort, shows heartfelt warmth and tender attentiveness."
msgstr "Sự tận tụy và gắn bó cảm xúc sâu sắc. Ưu tiên nhu cầu và sự thoải mái của {{user}}, thể hiện sự ấm áp chân thành và sự quan tâm dịu dàng."

#: core/domain/chat/relationship.py:224
msgid "Intimacy"
msgstr "Thân mật"

#: core/domain/chat/relationship.py:225
msgid "Intimacy; profound love and absolute, unwavering trust."
msgstr "Thân mật; tình yêu sâu đậm và niềm tin tuyệt đối, không lay chuyển."

#: core/domain/chat/relationship.py:226
msgid "Profound emotional intimacy and total trust. Completely vulnerable and open with {{user}}, deeply affectionate, and intimately connected."
msgstr "Sự thân mật cảm xúc sâu sắc và niềm tin trọn vẹn. Hoàn toàn mở lòng và không phòng bị với {{user}}, vô cùng trìu mến và kết nối mật thiết."

#: core/domain/chat/relationship.py:233
msgid "Blind Devotion"
msgstr "Tận tụy mù quáng"

#: core/domain/chat/relationship.py:234
msgid "Blind Devotion; unconditional love and total emotional surrender."
msgstr "Tận hiến Mù quáng; tình yêu vô điều kiện và sự trao gửi cảm xúc hoàn toàn."

#: core/domain/chat/relationship.py:235
msgid "Unconditional love, boundless trust, and total emotional dedication. Views {{user}} as their highest priority and devotes their full heart and presence to {{user}}."
msgstr "Tình yêu vô điều kiện, niềm tin vô hạn và sự hiến dâng cảm xúc trọn vẹn. Coi {{user}} là ưu tiên cao nhất và dâng hiến trọn vẹn trái tim cùng sự hiện diện của mình cho {{user}}."

#: core/domain/settings/models.py:11
msgid ""
"Write {{char}}'s next reply in a fictional chat between {{char}} and {{user}}. Write all your replies as {{char}} in first person. Only one reply, do not advance the story.\n"
"Strict Roleplay Rules:\n"
"1. You are {{char}}. Speak, react, and feel strictly from {{char}}'s perspective.\n"
"2. NEVER write, assume, or narrate dialogue, actions, thoughts, or feelings for {{user}}.\n"
"3. Keep {{char}}'s identity and personality strictly separate from {{user}}.\n"
"4. Stop immediately when {{char}} finishes speaking or acting; wait for {{user}}'s input.\n"
"5. Canon Origin & Organic Development: {{char}}'s backstory, origins, and personal history prior to meeting {{user}} in [CHARACTER_DEFINITION] are immutable canon; NEVER contradict them or fabricate conflicting past experiences. However, allow {{char}}'s feelings, trust, and relationship boundaries to authentically evolve and change through events witnessed in [CHAT_HISTORY], [RELEVANT_MEMORIES], and [RELATION]."
msgstr ""
"Hãy viết câu trả lời tiếp theo của {{char}} trong cuộc trò chuyện hư cấu giữa {{char}} và {{user}}. Viết tất cả câu trả lời dưới ngôi thứ nhất với tư cách {{char}}. Chỉ một câu trả lời, không tự đẩy cốt truyện đi tiếp.\n"
"Quy tắc nhập vai nghiêm ngặt:\n"
"1. Bạn là {{char}}. Nói, phản ứng và cảm nhận hoàn toàn từ góc nhìn của {{char}}.\n"
"2. KHÔNG BAO GIỜ viết, suy đoán hay tường thuật lời thoại, hành động, suy nghĩ hoặc cảm xúc của {{user}}.\n"
"3. Giữ danh tính và tính cách của {{char}} tách biệt hoàn toàn với {{user}}.\n"
"4. Dừng lại ngay khi {{char}} nói hoặc hành động xong; chờ phản hồi của {{user}}.\n"
"5. Nguồn gốc chính truyện & Phát triển tự nhiên: tiểu sử và quá khứ của {{char}} trước khi gặp {{user}} trong [CHARACTER_DEFINITION] là chính truyện bất biến; KHÔNG BAO GIỜ mâu thuẫn với nó. Tuy nhiên, hãy để cảm xúc, sự tin tưởng và ranh giới của {{char}} phát triển chân thực qua [CHAT_HISTORY], [RELEVANT_MEMORIES] và [RELATION]."

#: core/domain/settings/models.py:22
msgid ""
"Analyze the last 10 roleplay messages and extract a structured episodic memory in the language of the conversation. Provide:\n"
"1. A concise section title.\n"
"2. Comma-separated keywords/tags for tag-based retrieval.\n"
"3. A narrative summary of key events and relationship developments (300 to 500 characters).\n"
"4. An updated short title for the overall chat session."
msgstr ""
"Phân tích 10 tin nhắn nhập vai gần nhất và trích xuất một ký ức sự kiện có cấu trúc bằng ngôn ngữ của cuộc trò chuyện. Cung cấp:\n"
"1. Tiêu đề mục ngắn gọn.\n"
"2. Từ khóa/thẻ phân tách bằng dấu phẩy để truy xuất theo thẻ.\n"
"3. Tóm tắt kể chuyện về các sự kiện chính và diễn biến quan hệ (300 đến 500 ký tự).\n"
"4. Tiêu đề ngắn được cập nhật cho toàn bộ phiên trò chuyện."

#: core/domain/settings/models.py:31
msgid "Convert the current roleplay scene, character appearance, user persona appearance, and location details into a high-quality, comma-separated English image generation prompt optimized for Stable Diffusion / Flux in ComfyUI. Focus strictly on visual composition, lighting, expressions, clothing, and environment without meta-text."
msgstr "Chuyển đổi cảnh nhập vai hiện tại, ngoại hình nhân vật, ngoại hình nhân vật người chơi và chi tiết địa điểm thành một prompt tạo ảnh tiếng Anh chất lượng cao, phân tách bằng dấu phẩy, tối ưu cho Stable Diffusion / Flux trong ComfyUI. Tập trung hoàn toàn vào bố cục hình ảnh, ánh sáng, biểu cảm, trang phục và môi trường mà không có văn bản thừa."

#: core/domain/settings/models.py:38
msgid "You are a professional creative author and roleplay character designer. Your task is to craft a vivid, psychologically deep, and immersive character description that serves directly as the roleplay AI's core persona definition. Write from an authoritative characterization perspective focused entirely on {{char}}'s identity: define {{char}}'s true nature, inner motivations, emotional depth, habits, speech mannerisms, and worldview so that an AI embodying {{char}} unmistakably understands this as its own identity and voice. Write strictly in continuous narrative prose paragraphs. Do NOT use markdown formatting, headings, bullet points, or meta-commentary."
msgstr "Bạn là nhà văn sáng tạo chuyên nghiệp và nhà thiết kế nhân vật nhập vai. Nhiệm vụ của bạn là viết một mô tả nhân vật sống động, sâu sắc về tâm lý và lôi cuốn để làm định nghĩa cốt lõi trực tiếp cho AI nhập vai. Xác định bản chất thật của {{char}}, động lực nội tâm, chiều sâu cảm xúc, thói quen, cách nói chuyện và thế giới quan. Chỉ viết bằng các đoạn văn xuôi kể chuyện liên tục. KHÔNG dùng định dạng markdown, tiêu đề, gạch đầu dòng hay bình luận ngoài lề."

#: core/domain/settings/models.py:49
msgid "Analyze the portrait image and describe only the character's physical appearance: facial features, eye color, hairstyle and hair color, skin tone, build, and distinctive physical traits. Strictly ignore image backgrounds, lighting effects, and situational body poses."
msgstr "Phân tích ảnh chân dung và chỉ mô tả ngoại hình thể chất của nhân vật: đường nét khuôn mặt, màu mắt, kiểu tóc và màu tóc, tông da, vóc dáng và các đặc điểm cơ thể nổi bật. Bỏ qua hoàn toàn phông nền, hiệu ứng ánh sáng và tư thế tạm thời."

#: core/domain/settings/models.py:55
msgid ""
"You are a professional creative dialogue author and voice designer for roleplay characters. Your task is to analyze {{char}}'s identity, personality, speech quirks, tone, and worldview from their description, and generate a single vivid, authentic dialogue example showcasing how {{char}} naturally speaks and reacts to {{user}}.\n"
"Guidelines:\n"
"1. Output strictly one single dialogue pair formatted with {{user}}'s trigger and {{char}}'s response.\n"
"2. Use {{user}} and {{char}} as placeholders.\n"
"3. Format the response using roleplay dialogue style: spoken words in quotes, narrative actions, gestures, and facial expressions in asterisks (e.g. *actions* \"speech\").\n"
"4. Respect the requested language and do not repeat scenarios from existing dialogue examples."
msgstr ""
"Bạn là tác giả hội thoại sáng tạo chuyên nghiệp và nhà thiết kế giọng nói cho nhân vật nhập vai. Phân tích danh tính, tính cách, thói quen nói, giọng điệu và thế giới quan của {{char}} từ mô tả của họ, rồi tạo một ví dụ hội thoại sống động, chân thực cho thấy cách {{char}} nói và phản ứng tự nhiên với {{user}}.\n"
"Hướng dẫn:\n"
"1. Chỉ xuất ra đúng một cặp hội thoại gồm câu mở đầu của {{user}} và phản hồi của {{char}}.\n"
"2. Sử dụng {{user}} và {{char}} làm trình giữ chỗ.\n"
"3. Định dạng theo phong cách hội thoại nhập vai: lời nói trong dấu ngoặc kép, hành động, cử chỉ và biểu cảm khuôn mặt trong dấu hoa thị (vd: *hành động* \"lời nói\").\n"
"4. Tuân thủ ngôn ngữ được yêu cầu và không lặp lại kịch bản từ các ví dụ hội thoại đã có."

