msgstr "描述、性格与正史背景（以下所有出身事实、个人经历和特质均为正史真相）："

#: core/domain/chat/prompt_builder.py:407
msgid "World Name:"
msgstr "世界名称："

#: core/domain/chat/prompt_builder.py:460
msgid "Player"
msgstr "玩家"

#: core/domain/chat/prompt_builder.py:461
msgid "You"
msgstr "你"

#: core/domain/chat/prompt_builder.py:171
msgid "None."
msgstr "无。"

#: core/domain/chat/prompt_builder.py:264 core/domain/chat/prompt_builder.py:385
msgid "Physical Appearance:"
msgstr "外貌特征："

#: core/domain/chat/prompt_builder.py:382
msgid "Background & Personality:"
msgstr "背景与性格："

